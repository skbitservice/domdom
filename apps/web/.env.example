# Public client configuration — safe to expose in the browser.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put SUPABASE_SECRET_KEY / service_role keys in this file.
# Those belong only in Supabase Edge Functions (server-side).
